# LLM provider config for extraction and adjudication. Copy to .env (gitignored).
#
# Provider is chosen per run, not baked into records — but whichever ran is recorded on every
# LLM-derived field as vetting.adjudication.model, so judgments stay traceable and comparable.

# local | openrouter
MEP_PROVIDER=local

# Model ID for the chosen provider. Leave unset for `local` and the client uses whatever
# LM Studio currently has loaded, so swapping models in the LM Studio UI just works.
# MEP_MODEL=google/gemma-4-26b-a4b

# LM Studio endpoint (default shown).
# MEP_LOCAL_BASE_URL=http://localhost:1234/v1

# Required only when MEP_PROVIDER=openrouter.
# OPENROUTER_API_KEY=sk-or-v1-...
